# Only LOGIN_HOST is required for a framing check (the server issues the
# PoW challenge before checking credentials).

# LoginApp DNS name (EU: login.p1..p5.worldoftanks.eu).
LOGIN_HOST=login.p2.worldoftanks.eu
# UDP port (always 20016 for LoginApp).
LOGIN_PORT=20016
# basic | token | token2 (see connection_mgr.py).
AUTH_METHOD=basic
# Realm for the username JSON.
AUTH_REALM=EU
# Client language id (also selects pwd_token behavior; cn/vn hash it).
LANG=en
# Account login name (basic) — embedded in the username JSON.
LOGIN=
# Plaintext password (transformed per locale, then RSA-encrypted on wire).
PASSWORD=
# WGC fast token (token method) / upgraded token (token2 method).
TOKEN=
TOKEN2=
# Stored session BLOB TEXT (base64 DPAPI from preferences), passed
# through UNCHANGED; md5-hex of the blob ASCII goes into the username
# JSON (never the decrypted GUID). Empty mints a per-run v4 GUID
# (different token2 family than an established machine).
SESSION=
# Session persistence flag (game: temporary=str(int(not rememberUser))).
TEMPORARY=0
# WGC publication id in username JSON + clientContext (0 = PC launcher).
PUBLICATION=0
# LoginApp RSA-2048 public key PEM (2.4.0.0 live client; 2.4.0.1 has its
# own copy if you run that build instead).
PUBKEY_PATH=../World_of_Tanks_EU/2.4.0.0/res/loginapp_wot.pubkey
# 4th LogOnParams string (game default: {"lang_id","publication"} JSON).
CLIENT_CONTEXT=
# Entity-definitions MD5 (32 hex chars). The server rejects mismatches
# (status 70 "Defs digest mismatch"); value verified recomputable
# offline by wot/entdef (ComputeDigestFull, green vs the
# digest-dumper-mod BigWorld.digest ground truth). Empty = 16 zero
# bytes (framing checks only, always status 70).
DIGEST_HEX=
# Blowfish session key we offer as encryptionKey (16 chars). Empty =
# fresh alphanumeric per run (NUL-free; -raw-key flag for full-range
# RAND_bytes like the game). BLOCK_KEY_EMPTY=1 with -empty-key sends it
# empty instead (plaintext probe; the server refuses: status 64).
BLOCK_KEY=
BLOCK_KEY_EMPTY=
# Raw key bytes as hex (CE memory dumps are hex; the game's RAND_bytes
# key is full-range binary, unrepresentable as text). Overrides
# BLOCK_KEY when set. Required with -hijack: decrypts the game's 232 B
# LOGGED_ON reply out of the wotproxy dump (4-56 B, Blowfish key sizes).
BLOCK_KEY_HEX=
# RSA-encrypt LogOnParams (game path, 1) or send cleartext (0, probe).
ENCRYPTED=1
# Zero bytes prepended before the reqOff footer (experimental).
FOOTER_PAD=0
# Client MTU reported in baseAppLogin (IDA: serverConn+609, pcap 1300).
MTU=1300
# Per round-trip UDP timeout.
TIMEOUT=5s
# Login request resends before giving up (exe default 10, sub_140E68910).
LOGIN_ATTEMPTS=10
# Stage diagnostics to stderr (servermsg keys, sizes/hashes only).
VERBOSE=
# Proof-of-work solver budget (server easiness ~55% solves in ~0.1-2s).
SOLVE_TIMEOUT=120s
# PoW workers: max concurrent key attempts, 0 = auto (4).
THREADS=0
